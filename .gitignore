# Local credential drop — must never be committed (D33)
github_token
*.token
.guidester-token

# Credential drops. Deliberately NOT `*token*`: that also swallows legitimate
# source files (token_service.dart, auth_token.dart) and git ignores them
# silently, with no warning that they were skipped. Match credential files at
# the repo root only, where they actually get dropped.
/github_token
/new_toen
/*.token
/*_token
/.env
/.env.*

# Local helper scripts — may carry tokens, never pushed
fetch_repo.sh
fetch_feedback.sh

# Golden-test failure artifacts. Regenerated on every failing run, never a
# source of truth — the goldens themselves ARE committed.
**/test/failures/

# Client bug data — real names, tokens in the source threads, never pushed
analysis/data/

# Supabase CLI link state: project ref and organisation, never committed.
**/supabase/.temp/
